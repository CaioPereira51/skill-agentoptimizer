{
  "name": "@caiopereira51/agentoptimizer",
  "version": "0.5.0",
  "description": "Evidence-based audits for AI-assisted development workflows",
  "keywords": [
    "agent-skill",
    "ai-agents",
    "developer-tools",
    "prompt-engineering",
    "workflow-audit"
  ],
  "author": "Caio Pereira",
  "homepage": "https://github.com/CaioPereira51/skill-agentoptimizer#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CaioPereira51/skill-agentoptimizer.git"
  },
  "bugs": {
    "url": "https://github.com/CaioPereira51/skill-agentoptimizer/issues"
  },
  "type": "module",
  "bin": {
    "agent-optimizer": "./bin/agent-optimizer.js"
  },
  "exports": "./src/index.js",
  "files": [
    "bin/",
    "src/",
    "skills/",
    "docs/",
    "schemas/",
    "examples/",
    "eval/",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "lint": "node scripts/lint.js",
    "typecheck": "node scripts/typecheck.js",
    "build": "node scripts/build.js",
    "eval": "node bin/agent-optimizer.js eval --fixtures eval/fixtures.json",
    "verify": "npm test && npm run eval && npm run lint && npm run typecheck && npm run build",
    "prepack": "npm run verify"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
